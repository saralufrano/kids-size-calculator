{
  "name": "kids-size-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "web:copy": "node scripts/copy-web.mjs",
    "assets:generate": "npx @capacitor/assets generate --assetPath assets --iconBackgroundColor '#afdc99' --iconBackgroundColorDark '#afdc99' --splashBackgroundColor '#f6fcff' --splashBackgroundColorDark '#f6fcff'",
    "cap:add:ios": "npm run web:copy && cap add ios",
    "cap:add:android": "npm run web:copy && cap add android",
    "cap:sync": "npm run web:copy && cap sync",
    "cap:open:ios": "npm run cap:sync && cap open ios",
    "cap:open:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.14",
    "@capacitor/cli": "8.5.2"
  }
}
